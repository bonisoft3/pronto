{
  "$id": "https://bonisoft.org/pronto/identity/ory/identity.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A person",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "maxLength": 320,
          "ory.sh/kratos": {
            "credentials": {
              "code": {"identifier": true, "via": "email"}
            },
            "verification": {"via": "email"},
            "recovery": {"via": "email"}
          }
        },
        "name": {"type": "string", "title": "Name", "maxLength": 200}
      },
      "required": ["email"],
      "additionalProperties": false
    }
  },
  "required": ["traits"]
}
