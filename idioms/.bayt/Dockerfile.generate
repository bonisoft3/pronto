# generated from bayt.cue — do not edit
FROM idioms-setup AS generate
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents --exclude=.bayt/** --exclude=.pronto/proto-baseline.json --exclude=mise.local.lock --exclude=**/node_modules/** --exclude=.task/** --exclude=tests/** ** ./
RUN ["nu", "-c", "mise x -- ^deno run --config ((^mise where github:bonisoft3/pronto | str trim) | path join deno.json) --allow-read --allow-write=. --allow-run --allow-env ((^mise where github:bonisoft3/pronto | str trim) | path join write.ts) ."]
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/Taskfile.generate.yaml .bayt/bayt.generate.json ./.bayt/

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS generate_ctxs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents --exclude=.bayt/** --exclude=.pronto/proto-baseline.json --exclude=mise.local.lock --exclude=**/node_modules/** --exclude=.task/** --exclude=tests/** ** ./
COPY --from=idioms-setup_srcs /monorepo /monorepo
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS generate_srcs
COPY --from=generate_ctxs /monorepo /monorepo

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS generate_bayt_ctxs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents .bayt/compose.generate.yaml .bayt/Dockerfile.generate .bayt/bayt.generate.json .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/Taskfile.generate.yaml .bayt/process-compose.yaml ./
COPY --from=idioms-setup_bayt /monorepo /monorepo
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS generate_bayt
COPY --from=generate_bayt_ctxs /monorepo /monorepo
