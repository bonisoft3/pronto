COPY docker/Caddyfile /etc/caddy/Caddyfile
COPY .cert[s] /certs/
COPY --parents shell/index.html shell/shell.css shell/boot.js offline-first-sw.js shell/shell.yaml shell/shell.json shell/design.css shell/screens/counter.html shell/screens/counter.css shell/screens/todo.html shell/screens/todo.css shell/screens/grid.html shell/screens/grid.css shell/screens/timer.html shell/screens/timer.css shell/handlers/count.js shell/handlers/press.js shell/handlers/remove.js shell/handlers/roll.js shell/handlers/tally.js shell/handlers/tick.js messages/en.json messages/pt-BR.json /srv/
COPY --parents brief.html ir.html ir/card.css acceptance.md DESIGN.md /srv/docs/
