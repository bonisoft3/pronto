# The bus row, in carrier form. Conduit spells a column as Postgres's text
# output — `2026-09-22 14:18:21.84623+00`, `08:00:00`, `"1"` — and every
# pipeline's mapping would otherwise have to know each spelling. This runs
# first, so a mapping reads `this.data` as the carriers the entities declare,
# the same strings PostgREST and the client hold.
#
# `$carriers` is prepended by emit.cue: {table: {column: carrier}} over the
# tables the publication carries. A column it does not name (__table, txid,
# scope_id, a tsvector) passes through untouched. A value that is not the
# spelling measured for its carrier throws, and the pipeline's catch logs and
# drops the event: a guess here would be a second, quieter canonical form.

# The walsender renders a timestamptz in the SERVER's zone, and that text is
# what reaches the bus. The image runs UTC, so the offset is `+00`; a cluster
# whose postgres ran a half-hour zone would spell `+05:30`, which this layout
# refuses rather than mis-reads.
map pg_timestamp {
  root = this.ts_parse("2006-01-02 15:04:05Z07").ts_format("2006-01-02T15:04:05.000000Z", "UTC")
}

# An interval without a day or month part prints as clock text, hours
# unbounded; the carrier is total seconds with the fraction's zeros trimmed.
map pg_duration {
  let m = this.re_find_all_submatch("^([0-9]+):([0-9]{2}):([0-9]{2})(?:\\.([0-9]*?)0*)?$")
  root = if $m.length() != 1 {
    throw("duration is not clock text: " + this)
  } else {
    "PT" + ($m.index(0).index(1).number().int64() * 3600 + $m.index(0).index(2).number().int64() * 60 + $m.index(0).index(3).number().int64()).string() + if $m.index(0).index(4) == "" { "S" } else { "." + $m.index(0).index(4) + "S" }
  }
}

map pg_time {
  let m = this.re_find_all_submatch("^([0-9]{2}:[0-9]{2}:[0-9]{2})(?:\\.([0-9]{1,6}))?$")
  root = if $m.length() != 1 {
    throw("time is not clock text: " + this)
  } else {
    $m.index(0).index(1) + "." + ($m.index(0).index(2) + "000000").slice(0, 6)
  }
}

# Numeric text keeps the scale it was computed at; the carrier has no trailing
# fractional zeros and no negative zero.
map pg_decimal {
  root = if this.type() != "string" || !this.re_match("^-?[0-9]+(\\.[0-9]+)?$") {
    throw("decimal is not numeric text: " + this.string())
  } else {
    this.string().re_replace_all("^(-?[0-9]+\\.[0-9]*?)0+$", "$1").re_replace_all("\\.$", "").re_replace_all("^-0$", "0")
  }
}

map pg_bool {
  root = match this {
    "t" => true,
    "f" => false,
    _ => throw("bool is not t or f: " + this.string()),
  }
}

# conduit spells every column as Postgres text, integers included; a JSON
# number would have been truncated past 2^53 before this mapping saw it.
map pg_integer {
  root = if this.type() != "string" || !this.re_match("^-?[0-9]+$") {
    throw("integer is not decimal text: " + this.string())
  } else {
    this
  }
}

map pg_date {
  root = if !this.re_match("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") { throw("date is not YYYY-MM-DD: " + this) } else { this }
}

# A column no carrier names, or a null, passes through as it came.
map carrier {
  root = if (this.type == null) || (this.value == null) { this.value } else {
    match {
      this.type == "timestamp" => this.value.apply("pg_timestamp"),
      this.type == "duration" => this.value.apply("pg_duration"),
      this.type == "time" => this.value.apply("pg_time"),
      this.type == "decimal" => this.value.apply("pg_decimal"),
      this.type == "bool" => this.value.apply("pg_bool"),
      this.type == "date" => this.value.apply("pg_date"),
      this.type == "int32" => this.value.apply("pg_integer").int64(),
      this.type == "int64" => this.value.apply("pg_integer"),
      this.type == "double" => this.value.number(),
      this.type == "uuid" => this.value.lowercase(),
      this.type == "string" => this.value,
      this.type == "timezone" => this.value,
      _ => throw("no measured bus spelling for " + this.type + "; measure conduit's before publishing one"),
    }
  }
}

# use_number keeps an integer past 2^53 exact: this mapping re-encodes every
# row it reads, and a float64 round trip would rewrite a txid silently.
let row = this.data.parse_json(use_number: true)
let table = if $row.type() != "object" || !$row.exists("__table") {
  throw("a bus row is a JSON object conduit stamped __table: " + this.data)
} else {
  $row.__table
}
let types = $carriers.get($table).or({})
root = this
let typed = $row.map_each(c -> {"type": $types.get(c.key), "value": c.value}.apply("carrier"))
root.data = $typed.format_json(no_indent: true, escape_html: false).string()
