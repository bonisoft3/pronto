# One door, and it is h2. A browser caps HTTP/1.1 at six connections per
# origin; an Electric live shape is a long-poll that holds one for its whole
# timeout, and a screen subscribes one per table — so on 1.1 the shapes eat the
# pool and everything else queues behind them. Measured on the nine-table
# article route: slowest shape 20 027 ms on 1.1 against 142 ms on h2, and the
# screen rendered in 1 552 ms against 647 ms
# (plugins/pronto/docs/2026-08-09-connection-ceiling.md). h2 multiplexes every
# stream over one connection, so the cap stops being something to count against.
#
# Browsers negotiate h2 only over TLS — none of them speak cleartext h2 — so the
# door is https, on a certificate mkcert issued and the developer trusted once.
# "just setup" writes the pair (the cluster declares it as a setup check);
# "mise exec -- mkcert -install" trusts it. The plain listener stays bound
# INSIDE the container for the healthcheck and is no longer published, so there
# is no plain-http path left to drift onto.
(app) {
  handle /crud/* {
    uri strip_prefix /crud
    @post method POST
    request_header @post Prefer "return=representation,resolution=ignore-duplicates"
    reverse_proxy crud:3000
  }
  handle /electric/* {
    uri strip_prefix /electric
    reverse_proxy electric:3000 {
      flush_interval -1
      transport http {
        read_timeout 300s
      }
    }
  }
  # No strip_prefix: the auth service mounts its routes WITH the /auth
  # prefix. Ships unconditionally — in a cluster without an auth service
  # the upstream never resolves and this unused route just 502s.
  handle /auth/* {
    reverse_proxy auth:9999
  }
  # The blob plane. Ships unconditionally, like /auth — in a cluster
  # without the blobs services the upstreams never resolve and these
  # unused routes just 502.
  handle /blobs/* {
    uri strip_prefix /blobs
    reverse_proxy rclone-s3:3900
  }
  handle /img/* {
    uri strip_prefix /img
    reverse_proxy imgproxy:8081
  }
  handle /health {
    respond "ok" 200
  }
  handle /omnishell/* {
    uri strip_prefix /omnishell
    root * /omnishell
    # Statics revalidate every load (Last-Modified 304s): dev-loop edits and
    # redeployed bundles must never be pinned by the browser's heuristic cache.
    header Cache-Control "no-cache"
    file_server
  }
  handle {
    root * /srv
    header Cache-Control "no-cache"
    file_server
  }
}

:8080 {
  import app
}

# The published door. Hostname-scoped: a port-only address would make the
# automation policy a catch-all and conflict with :8080's default.
#
# The certificate is mkcert's, mounted from the host rather than issued here.
# `tls internal` would be simpler and is wrong for this: Caddy's root would
# live inside the container, so no browser on the host could ever trust it, and
# an untrusted certificate is worse than plain http — the interstitial blocks
# WebAuthn outright, where http://localhost is a secure context and passkeys
# work. mkcert puts the root in the host trust store instead, where the browser
# can see it.
https://localhost:8443 {
  tls /certs/localhost.pem /certs/localhost-key.pem
  import app
}
