# The cluster's one door, h2 over TLS: libraries/mecha/docs/proxy.md.

# Every file the door serves, answered with its validator: mecha's caddy
# writes each file's content hash beside it as `<file>.etag` (cluster.cue),
# since the ETag file_server would derive is mtime and size, which an image
# built with clamped mtimes reduces to size. `encode` suffixes it per coding and
# strips that suffix from a revalidation. The sidecars themselves are no
# content.
(files) {
  file_server {
    etag_file_extensions .etag
    hide *.etag
  }
}

# A file answered through `templates`, its arguments the media types rendered.
# `templates` deletes the ETag, since what a template renders is in general no
# function of the file; these render the file and the deployment's origin, so
# the file's validator names the answer. The last `header`
# copies it as file_server sets it; once the template has run, the second puts
# it back, and the first drops the copy, deferred ops running innermost first.
# A revalidation of an unchanged file is answered 304 by file_server, which no
# template reads. `route`, so they run as written.
(templated) {
  route {
    header {
      -X-Template-Validator
      defer
    }
    header {
      match header X-Template-Validator "\"*"
      >ETag {http.response.header.X-Template-Validator}
    }
    templates {
      mime {args[0:]}
    }
    header >X-Template-Validator {http.response.header.ETag}
    import files
  }
}

# Tracing where a collector runs (a k8s release sets PRONTO_TRACING=on): caddy
# ignores OTEL_TRACES_EXPORTER and OTEL_SDK_DISABLED, so without a collector
# every export batch would spend its deadline dialing one.
(tracing-on) {
  tracing
}
(tracing-off) {
}

# Each upstream's bound is `import bounded-<hop>`, a snippet emitted ahead of
# this file from plugins/pronto/resilience.
(app) {
  # Every request is a span, the child of the traceparent it arrived with (the
  # gateway's), and every upstream is sent the span's own; the access log names
  # its traceID. The exporter reads the standard OTEL_* environment.
  import tracing-{$PRONTO_TRACING:off}
  log
  # The origin every absolute address the app answers is spelled against,
  # read by a template as `http.vars.origin`. The deployment's, never the
  # request's: this door answers any Host (mecha's docs/proxy.md, "The origin").
  vars origin {$ORIGIN}
  # Another name the deployment answers to (a gcp release's aliases, such as
  # www) sends the reader on to the origin: a passkey's relying party is the
  # origin alone. Unset, it names a host nobody asks for.
  @alias host {$PRONTO_ALIASES:alias.invalid}
  redir @alias {$ORIGIN}{uri} 308
  # The interpreter ships as plain ES modules plus a vendored data-plane
  # driver measured in hundreds of KiB; compression at the door is what keeps
  # a cold cache from paying for that in seconds on a slow link.
  encode zstd gzip
  # Chromium probes /favicon.ico unsolicited; serve the file if present, or
  # answer 204 to prevent console errors that break Best Practices audits
  # without paying for an asset.
  handle /favicon.ico {
    root * /srv
    @favicon file /favicon.ico /shell/favicon.ico /favicon.svg /shell/favicon.svg /favicon.png /shell/favicon.png
    handle @favicon {
      header Cache-Control "no-cache"
      rewrite {http.matchers.file.relative}
      import files
    }
    handle {
      respond "" 204
    }
  }
  # Web App Manifest: serve with application/manifest+json; alias /manifest.json.
  handle /manifest.webmanifest {
    root * /srv
    @manifest file /manifest.webmanifest /shell/manifest.webmanifest
    handle @manifest {
      header Content-Type "application/manifest+json"
      header Cache-Control "no-cache"
      rewrite {http.matchers.file.relative}
      import files
    }
    handle {
      respond "" 404
    }
  }
  handle /shell/manifest.webmanifest {
    root * /srv
    header Content-Type "application/manifest+json"
    header Cache-Control "no-cache"
    import files
  }
  handle /manifest.json {
    redir /manifest.webmanifest 308
  }
  # Every upstream is dialed at its own PRONTO_UPSTREAM_<SERVICE> when set and
  # named by dapr-app-id: a k8s release sets each to the caddy pod's Dapr
  # sidecar, which routes by that header (service invocation) and keeps the
  # path; a gcp release to the service's localhost port in the one Cloud Run
  # instance they share; compose and docker leave them unset and dial the
  # service directly.
  handle /crud/* {
    uri strip_prefix /crud
    @post method POST
    request_header @post Prefer "return=representation,resolution=ignore-duplicates"
    reverse_proxy {$PRONTO_UPSTREAM_CRUD:crud:3000} {
      header_up dapr-app-id crud
      import bounded-crud
    }
  }
  handle /electric/* {
    uri strip_prefix /electric
    # Electric names four parameters the server must own, and a client that
    # reaches it directly owns all of them: `table` chooses any table, `where`
    # IS the authorization filter. Caddy cannot decide them -- that means asking
    # which scopes a subject holds -- so it asks the gatekeeper, which already
    # can, and which compares what was authorized against what arrives here.
    #
    # Unconditional, and it has to be: an Electric reachable without this is
    # the hole. Every cluster with an electric service has an auth service for
    # exactly that reason.
    # `route`, because Caddy orders directives by its own table and not by the
    # order they are written: `uri` sorts ahead of `forward_auth`, so outside a
    # route the secret is added BEFORE the gate sees the request and the gate
    # refuses the parameter the proxy itself just set. Inside, these run as
    # written.
    route {
      forward_auth {$PRONTO_UPSTREAM_AUTH:auth:9999} {
        uri /auth/shape/verify
        header_up dapr-app-id auth
        import bounded-auth
      }
      # Electric takes its secret as a query parameter, added by an authorizing
      # proxy and never sent by a client. It is set after the gate, so a client
      # that supplies its own is refused there rather than silently overwritten.
      uri query secret {$ELECTRIC_SECRET}
      reverse_proxy {$PRONTO_UPSTREAM_ELECTRIC:electric:3000} {
        header_up dapr-app-id electric
        flush_interval -1
        import bounded-electric
        # Electric's 5xx reaches the client without its text: mecha's services/proxy/Caddyfile says why.
        @fault status 5xx
        handle_response @fault {
          copy_response_headers {
            exclude Content-Type Content-Length Content-Encoding Server
          }
          header Content-Type application/json
          respond `{"message":"electric failed"}` {rp.status_code}
        }
      }
    }
  }
  # No strip_prefix: the auth service mounts its routes WITH the /auth
  # prefix. Ships unconditionally — in a cluster without an auth service
  # the upstream never resolves and this unused route just 502s.
  handle /auth/* {
    reverse_proxy {$PRONTO_UPSTREAM_AUTH:auth:9999} {
      header_up dapr-app-id auth
      import bounded-auth
    }
  }
  # The wake. Ships unconditionally like /auth, and mounted WITH its prefix
  # for the same reason: the ticker answers POST /poke and 404s everything
  # else, so stripping would 404 every poke.
  handle /poke {
    reverse_proxy {$PRONTO_UPSTREAM_TICKER:ticker:9998} {
      header_up dapr-app-id ticker
      import bounded-ticker
    }
  }
  # The blob plane. Ships unconditionally, like /auth — in a cluster
  # without the blobs services the upstreams never resolve and these
  # unused routes just 502.
  handle /blobs/* {
    # The store authorizes nothing, so the gate decides (emit.cue's
    # #blobGateSql, asked through the REST gateway, which verifies the
    # session): an account's PUT of a picture under its own id, at most 5 MB,
    # and nothing else. `route` keeps these in the order written, as /electric's.
    route {
      request_body {
        max_size 5MB
      }
      forward_auth {$PRONTO_UPSTREAM_CRUD:crud:3000} {
        uri /rpc/blob_gate
        header_up dapr-app-id crud
        import bounded-crud
      }
      uri strip_prefix /blobs
      reverse_proxy {$PRONTO_UPSTREAM_RCLONE_S3:rclone-s3:3900} {
        header_up dapr-app-id rclone-s3
        import bounded-blobs
      }
    }
  }
  handle /img/* {
    uri strip_prefix /img
    reverse_proxy {$PRONTO_UPSTREAM_IMGPROXY:imgproxy:8081} {
      header_up dapr-app-id imgproxy
      import bounded-blobs
    }
  }
  handle /health {
    respond "{$K_REVISION:ok}" 200
  }
  # The two files a crawler asks for by name, and neither works anywhere but
  # the origin root. Both name absolute URLs — a sitemap <loc> and the Sitemap:
  # line are defined to be absolute — and the build cannot know the origin: the
  # same image answers on https://localhost:8443 and on the deployed door. So
  # they ship as templates spelling the origin above.
  handle /robots.txt {
    root * /srv
    import templated text/plain
  }
  handle /sitemap.xml {
    root * /srv
    import templated application/xml text/xml
  }
  # LLM discovery documents. Served from the root with markdown typing.
  handle /llms.txt {
    root * /srv
    @llms file /llms.txt
    handle @llms {
      header Content-Type "text/markdown; charset=utf-8"
      header Cache-Control "no-cache"
      import files
    }
    handle {
      respond "" 404
    }
  }
  handle /llms-full.txt {
    root * /srv
    @llmsfull file /llms-full.txt
    handle @llmsfull {
      header Content-Type "text/markdown; charset=utf-8"
      header Cache-Control "no-cache"
      import files
    }
    handle {
      respond "" 404
    }
  }
  # Platform well-knowns (Universal Links, App Links, passkeys).
  # iOS apple-app-site-association has no file extension; set application/json.
  handle /.well-known/* {
    root * /srv
    @extensionless path_regexp ^/\.well-known/[^/.]+$
    header @extensionless Content-Type "application/json"
    header Cache-Control "no-cache"
    import files
  }
  handle /omnishell/* {
    uri strip_prefix /omnishell
    root * /omnishell
    # Statics revalidate every load (304s on their validator): dev-loop edits and
    # redeployed bundles must never be pinned by the browser's heuristic cache.
    header Cache-Control "no-cache"
    import files
  }
  handle {
    root * /srv
    header Cache-Control "no-cache"
    import files
  }
}

:{$PORT:8080} {
  import app
}

# The published door, by the two names it answers (mecha's docs/proxy.md, "The
# certificate"). Hostname-scoped: a port-only address would make the automation
# policy a catch-all and conflict with :8080's default.
#
# localhost, for a person's browser: mkcert's pair when the host issued one
# (CADDY_TLS, set as the container starts), Caddy's own CA otherwise.
https://localhost:8443 {
  tls {$CADDY_TLS:internal}
  header Alt-Svc `h3=":{$CADDY_TLS_HOST_PORT:20879}"; ma=2592000`
  import app
}

# caddy, for the integrate checkers on the cluster's network, so they speak the
# protocol a reader gets: Electric holds one long-poll per table a screen reads,
# and on HTTP/1.1's six connections per host a screen reading more stalls. Its
# own block, so mkcert's localhost-only pair never leaves this name to a public
# CA.
https://caddy:8443 {
  tls internal
  import app
}
